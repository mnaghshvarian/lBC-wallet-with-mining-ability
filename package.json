{
  "name": "lbc-wallet-monorepo",
  "private": true,
  "version": "1.1.0",
  "description": "Non-custodial LBRY Credits (LBC) wallet with built-in mining",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:wasm": "npm run build -w @lbcwallet/miner-wasm",
    "dev": "npm run dev -w lbc-wallet-desktop",
    "build": "npm run build -w lbc-wallet-desktop",
    "dist": "npm run dist -w lbc-wallet-desktop",
    "test": "npm run test -w @lbcwallet/core -w @lbcwallet/services -w @lbcwallet/ui -w lbc-wallet-desktop -w lbc-wallet-mobile",
    "test:e2e": "npm run test:e2e -w @lbcwallet/core",
    "typecheck": "npm run typecheck -w @lbcwallet/core -w @lbcwallet/services -w @lbcwallet/ui -w lbc-wallet-desktop -w lbc-wallet-mobile",
    "regtest": "tsx packages/core/e2e/dev-regtest.ts",
    "build:android": "npm run build:android:release -w lbc-wallet-mobile",
    "docs:pdf": "node scripts/manual-pdf.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "marked": "18.0.14",
    "tsx": "4.23.15"
  }
}
