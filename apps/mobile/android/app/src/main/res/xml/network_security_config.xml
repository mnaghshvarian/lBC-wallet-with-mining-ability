<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, with the system's certificate authorities (no user-added CAs). Hub connections
     are raw TCP/TLS sockets handled by LbcNativePlugin. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
